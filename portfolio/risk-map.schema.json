{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-test-automation-frameworks.github.io/.github/portfolio/risk-map.schema.json",
  "title": "Release assurance risk map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "application", "frameworkContexts", "risks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "application": { "$ref": "#/$defs/application" },
    "frameworkContexts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/frameworkContext" }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/risk" }
    }
  },
  "$defs": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "apiVersions"],
      "properties": {
        "repository": { "const": "qa-test-automation-frameworks/quality-reference-application" },
        "apiVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["v1", "v2"] }
        }
      }
    },
    "frameworkContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "sourceSha"],
      "properties": {
        "repository": {
          "enum": [
            "qa-test-automation-frameworks/aria-api-framework",
            "qa-test-automation-frameworks/playwright-typescript-framework"
          ]
        },
        "ref": { "type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$" },
        "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "scopeId", "allowedProfiles"],
      "properties": {
        "repository": {
          "enum": [
            "qa-test-automation-frameworks/aria-api-framework",
            "qa-test-automation-frameworks/playwright-typescript-framework"
          ]
        },
        "scopeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
        "allowedProfiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": ["string", "null"], "maxLength": 100 }
        }
      }
    },
    "faultControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "detectorRepository", "nativeTestIds", "proofMaxAgeHours", "mutationRequired"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
        "detectorRepository": { "const": "qa-test-automation-frameworks/quality-reference-application" },
        "nativeTestIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 240 }
        },
        "proofMaxAgeHours": { "type": "integer", "minimum": 1, "maximum": 720 },
        "mutationRequired": { "const": true }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "ownerRepository", "relevantApiVersions", "requiredScopes", "expectedFaultControl", "residualLimitations"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "description": { "type": "string", "minLength": 10, "maxLength": 500 },
        "ownerRepository": { "const": "qa-test-automation-frameworks/quality-reference-application" },
        "relevantApiVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["v1", "v2"] }
        },
        "requiredScopes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scope" }
        },
        "expectedFaultControl": { "$ref": "#/$defs/faultControl" },
        "residualLimitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 8, "maxLength": 500 }
        }
      }
    }
  }
}
